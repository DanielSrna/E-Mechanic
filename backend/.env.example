# ========================================
# E-Mechanic API - Variables de Entorno
# ========================================
# Copia este archivo como .env y completa los valores

# Puerto del servidor
PORT=3000

# URL de conexión a MongoDB Atlas
# Formato: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<db>
MONGODB_URL=mongodb+srv://user:pass@cluster.mongodb.net/e_mechanic

# Entorno de ejecución: development | production | test
NODE_ENV=development

# URL del frontend (puede ser múltiples separadas por coma)
# Ej: http://localhost:5173,https://tu-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Secretos JWT — generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=genera_un_secreto_de_64_bytes_aleatorio
JWT_SECRET_EXPIRES_IN=1d
JWT_REFRESH_SECRET=genera_otro_secreto_de_64_bytes_aleatorio
JWT_REFRESH_SECRET_EXPIRES_IN=7d

# Salt rounds para bcrypt (10-12 recomendado)
BCRYPT_SALT_ROUNDS=10

# Stripe (opcional - necesario para pagos en Fase 4)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# SMTP para envío de facturas por email (Obligatorio para enviar facturas)
# Desarrollo: usa Mailtrap (https://mailtrap.io) para probar sin enviar emails reales
# Producción: usa Gmail, Outlook, SendGrid, Mailgun, etc.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=tu-contraseña-de-aplicacion

# Google Cloud Storage para imágenes (opcional)
# Si no se configura, las imágenes se guardan en el sistema de archivos local
# GCS_PROJECT_ID=tu-proyecto-id
# GCS_BUCKET_NAME=emechanic-uploads
# GCS_CLIENT_EMAIL=servicio-cuenta@proyecto.iam.gserviceaccount.com
# GCS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
