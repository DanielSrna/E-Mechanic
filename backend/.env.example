# ========================================
# E-Mechanic API - Variables de Entorno
# ========================================
# Copia este archivo como .env y completa los valores

# Puerto del servidor
PORT=3000

# URL de conexión a MongoDB Atlas
# Formato: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<db>
MONGODB_URL=mongodb+srv://user:pass@cluster.mongodb.net/e_mechanic

# Entorno de ejecución: development | production | test
NODE_ENV=development

# URL del frontend (puede ser múltiples separadas por coma)
# Ej: http://localhost:5173,https://tu-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Secretos JWT (usar strings largos y aleatorios en producción)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_SECRET_EXPIRES_IN=1d
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_largo_y_diferente
JWT_REFRESH_SECRET_EXPIRES_IN=7d

# Salt rounds para bcrypt (10-12 recomendado)
BCRYPT_SALT_ROUNDS=10

# Stripe (opcional - necesario para pagos en Fase 4)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# SMTP para envío de emails (facturas, notificaciones)
# Si no se configura, los emails no se enviarán
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=tu-contraseña-de-aplicacion
