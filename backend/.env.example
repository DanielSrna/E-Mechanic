# ========================================
# E-Mechanic — Variables de Entorno
# ========================================
# Copia este archivo como .env y completa los valores

# ---------- REQUERIDO ----------
# MongoDB Atlas (gratis: https://atlas.mongodb.com)
MONGODB_URL=mongodb+srv://user:pass@cluster.mongodb.net/e_mechanic

# Secretos JWT (generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=genera_un_secreto_de_64_bytes_aleatorio
JWT_REFRESH_SECRET=genera_otro_secreto_de_64_bytes_aleatorio

# ---------- OPCIONAL ----------

# Puerto (default: 3000)
PORT=3000

# Entorno: development | production | test
NODE_ENV=development

# URL(s) del frontend (separadas por coma)
FRONTEND_URL=http://localhost:5173

# Expiración de tokens JWT
JWT_SECRET_EXPIRES_IN=1d
JWT_REFRESH_SECRET_EXPIRES_IN=7d

# Salt rounds para bcrypt (10-12)
BCRYPT_SALT_ROUNDS=10

# Impuesto para facturas (default: 0.19 = 19%)
TAX_RATE=0.19

# ---------- EMAIL: Gmail SMTP (PRIMARIO, 500 emails/día gratis) ----------
# 1. Activa verificación en 2 pasos en tu cuenta Google
# 2. Genera una contraseña de aplicación en https://myaccount.google.com/apppasswords
# 3. Completa los valores abajo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=e.mechanic98@gmail.com
SMTP_PASS=tu-app-password-de-16-caracteres

# ---------- EMAIL: Resend (SECUNDARIO, fallback) ----------
# Si Gmail SMTP falla, el sistema intenta con Resend
# Plan gratuito: 100 emails/día. Regístrate en https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- GOOGLE CLOUD STORAGE (OPCIONAL) ----------
# Sin esto, las imágenes se guardan en disco local (uploads/)
# GCS_PROJECT_ID=tu-proyecto
# GCS_BUCKET_NAME=emechanic-uploads
# GCS_CLIENT_EMAIL=cuenta@proyecto.iam.gserviceaccount.com
# GCS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# ---------- REDIS (OPCIONAL, FUTURO) ----------
# Para rate limiting distribuido en producción multi-instancia
# REDIS_URL=redis://localhost:6379

# ---------- SWAGGER (OPCIONAL) ----------
# URL base para Swagger UI en producción
# SWAGGER_SERVER_URL=https://api.tudominio.com
