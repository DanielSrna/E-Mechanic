{
  "name": "backend",
  "version": "1.0.0",
  "description": "E-Mechanic API — ERP para talleres de motocicletas",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "test:integration": "node --experimental-vm-modules node_modules/.bin/jest --testPathPattern='__tests__/integration/'",
    "test:ci": "node --experimental-vm-modules node_modules/.bin/jest --no-coverage --ci",
    "seed": "node seed.js",
    "seed:force": "node seed.js --force",
    "setup": "node seed.js && echo '✅ Setup completo. npm run dev para arrancar'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.1.0",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.18.0",
    "resend": "^6.12.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.4.1"
  }
}
